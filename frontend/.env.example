# Copia este archivo como .env.local y rellena los valores. NUNCA subas .env.local al repo.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string (usa la contraseña NUEVA)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Opcionales
GEMINI_API_KEY=
AI_API_URL=http://127.0.0.1:8000
OLLAMA_API_URL=http://localhost:11434

# Copia este archivo como .env y rellena los valores. NUNCA subas .env al repo (está en .gitignore).

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase → Project Settings → Database → Connection string (usa la contraseña NUEVA)
DATABASE_URL=postgresql://postgres.TU-PROYECTO:CONTRASEÑA@aws-1-us-east-2.pooler.supabase.com:6543/postgres

# Opcionales
GEMINI_API_KEY=
# Consultas de IA por farmacia y día (protege la cuota gratuita)
AI_DAILY_LIMIT=40
# Modelo de Gemini (por defecto gemini-flash-lite-latest)
GEMINI_MODEL=
AI_API_URL=http://127.0.0.1:8000
OLLAMA_API_URL=http://localhost:11434

# Sentry → Settings → Projects → Client Keys (DSN). Vacío = Sentry apagado (recomendado en local)
NEXT_PUBLIC_SENTRY_DSN=

# Vercel → Settings → Environment Variables. Protege /api/cron/reset-demo (restauración nocturna de la demo)
CRON_SECRET=
